# Token do bot Discord — criado em https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# ID do servidor (guild). Modo desenvolvedor ativo > clique direito no servidor > Copy Server ID
DISCORD_GUILD_ID=

# Seu user ID Discord (opcional). Usado pra destacar menções no relatório consolidado.
DISCORD_USER_ID=

# IDs de canais a ignorar, separados por vírgula (opcional)
EXCLUDE_CHANNEL_IDS=

# Janela de horas a puxar (default 24)
PULL_WINDOW_HOURS=24
