{
  "name": "@gregio/kb",
  "version": "0.6.1",
  "type": "module",
  "description": "CLI do harness de desenvolvimento com IA: base de conhecimento pessoal (vaults Obsidian, grafo central, ciclo de planos) mais o bootstrap e os guardrails do ambiente (scaffold, doctor, status, map, rules, guard)",
  "keywords": [
    "knowledge-base",
    "obsidian",
    "vault",
    "claude-code",
    "ai-harness",
    "knowledge-graph",
    "cli",
    "developer-tools"
  ],
  "license": "MIT",
  "author": "Guilherme Gregio",
  "homepage": "https://github.com/guilhermegregio/gregio-marketplace/tree/main/cli/kb#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guilhermegregio/gregio-marketplace.git",
    "directory": "cli/kb"
  },
  "bugs": {
    "url": "https://github.com/guilhermegregio/gregio-marketplace/issues"
  },
  "bin": {
    "kb": "bin/kb.js"
  },
  "files": [
    "bin/",
    "src/",
    "templates/",
    "rules/",
    "kb.config.example.json"
  ],
  "scripts": {
    "kb": "node bin/kb.js",
    "kb:graph": "node bin/kb.js graph build",
    "kb:serve": "node bin/kb.js graph serve",
    "prepack": "node scripts/sync-rules.mjs"
  },
  "engines": {
    "node": ">=20.6"
  },
  "publishConfig": {
    "access": "public"
  }
